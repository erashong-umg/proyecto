@startuml
title Diagrama UML General de Casos de Uso\nPlataforma de Tutorías

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FBFF
  BorderColor #24558A
  ArrowColor #52677D
}
skinparam actorStyle awesome

actor Visitante as visitante
actor "Usuario autenticado" as usuario
actor Estudiante as estudiante
actor Tutor as tutor
actor Administrador as admin
actor "Google OAuth 2.0" as google
actor "Servicio de mapas y rutas\n(Google Maps / OpenStreetMap)" as mapas
actor "Servicio de mensajería\n(Socket.io)" as socket
actor "Servicio de pagos\n(mockup)" as pagos

rectangle "Plataforma web de tutorías" {

  package "1. Autenticación, roles y onboarding" {
    usecase "CU-01\nRegistrarse e iniciar sesión\ncon Google" as CU01
    usecase "CU-02\nCerrar sesión" as CU02
    usecase "CU-03\nCompletar perfil" as CU03
    usecase "CU-04\nSeleccionar rol principal" as CU04
    usecase "CU-05\nRegistrar ubicación habitual" as CU05
    usecase "CU-06\nRegistrar credenciales\nacadémicas y profesionales" as CU06
    usecase "CU-07\nRegistrar categorías\nde afinidad" as CU07
    usecase "CU-08\nValidar JWT en solicitudes" as CU08
    usecase "CU-09\nRestringir navegación\nde cuenta suspendida" as CU09
    usecase "CU-10\nConsultar suspensión\ny presentar apelación" as CU10
    usecase "CU-11\nAprobar solicitud\nde tutor" as CU11
  }

  package "2. Gestión de tutores y oferta académica" {
    usecase "CU-12\nConsultar categorías" as CU12
    usecase "CU-13\nCrear oferta de tutoría" as CU13
    usecase "CU-14\nModificar oferta de tutoría" as CU14
    usecase "CU-15\nDesactivar o eliminar oferta" as CU15
    usecase "CU-16\nConfigurar modalidades\ny tarifas" as CU16
    usecase "CU-17\nAdministrar categorías\ny subcategorías" as CU17
    usecase "CU-18\nConsultar perfil público\ndel tutor" as CU18
    usecase "CU-19\nCompartir perfil por WhatsApp" as CU19
  }

  package "3. Búsqueda geoespacial y rutas" {
    usecase "CU-20\nBuscar tutores" as CU20
    usecase "CU-21\nFiltrar por categoría,\nmodalidad y precio" as CU21
    usecase "CU-22\nFiltrar por cercanía" as CU22
    usecase "CU-23\nFiltrar por calificación\ny cantidad de reseñas" as CU23
    usecase "CU-24\nConsultar ubicación\ny ruta" as CU24
    usecase "CU-25\nCalcular presupuesto\nde tutoría y traslado\n(viaje redondo)" as CU25
    usecase "CU-57\nTrazar ruta manualmente" as CU57
  }

  package "4. Disponibilidad, agendamiento y suscripciones" {
    usecase "CU-26\nConfigurar disponibilidad semanal" as CU26
    usecase "CU-27\nConsultar calendario\n(diario, semanal, mensual)" as CU27
    usecase "CU-28\nSolicitar contratación\nde tutoría" as CU28
    usecase "CU-29\nProgramar sesiones recurrentes" as CU29
    usecase "CU-30\nValidar disponibilidad\ny prevenir traslapes" as CU30
    usecase "CU-31\nConsultar detalle de sesión" as CU31
    usecase "CU-32\nCancelar tutoría\n(mínimo 2 horas antes)" as CU32
    usecase "CU-33\nRegistrar cumplimiento\nde sesión" as CU33
    usecase "CU-34\nConsultar historial\nde tutorías" as CU34
    usecase "CU-56\nSolicitar devolución\no reasignación de tutor" as CU56
  }

  package "5. Mensajería y comunicación" {
    usecase "CU-35\nConsultar conversaciones" as CU35
    usecase "CU-36\nEnviar mensaje privado" as CU36
    usecase "CU-37\nRecibir mensajes en tiempo real" as CU37
    usecase "CU-38\nConsultar confirmaciones\nde lectura" as CU38
  }

  package "6. Calificaciones y reseñas" {
    usecase "CU-39\nCalificar sesión completada" as CU39
    usecase "CU-40\nAgregar comentario" as CU40
    usecase "CU-41\nEditar reseña durante\nlas primeras 72 horas" as CU41
    usecase "CU-42\nActualizar promedio\ny cantidad de reseñas" as CU42
  }

  package "7. Seguridad, reportes y apelaciones" {
    usecase "CU-43\nDenunciar a otro usuario" as CU43
    usecase "CU-44\nConsultar reportes activos" as CU44
    usecase "CU-45\nConsultar historial\nde reportes por usuario" as CU45
    usecase "CU-46\nRecibir notificación\nde reporte" as CU46
    usecase "CU-47\nPresentar apelación\ncon pruebas" as CU47
    usecase "CU-48\nRevisar y resolver apelaciones" as CU48
    usecase "CU-49\nSuspender o reactivar cuenta" as CU49
    usecase "CU-58\nConsultar reporte simplificado" as CU58
  }

  package "8. Administración y reportería" {
    usecase "CU-50\nConsultar panel administrativo" as CU50
    usecase "CU-51\nConsultar tutores mejor\ny peor calificados" as CU51
    usecase "CU-52\nConsultar categorías\ncon mayor demanda" as CU52
    usecase "CU-53\nConsultar tutorías impartidas\ny canceladas" as CU53
    usecase "CU-54\nConsultar gráficos estadísticos" as CU54
  }

  package "9. Pagos (prototipo)" {
    usecase "CU-55\nVisualizar y simular\nflujo de pago (mockup)" as CU55
  }
}

' Asociaciones de actores
visitante --> CU01
visitante --> CU18
visitante --> CU19

usuario --> CU02
usuario --> CU03
usuario --> CU04
usuario --> CU05
