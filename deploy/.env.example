# Copiar a ".env" en el mismo directorio del servidor donde vive compose.yml
# (ver docs/despliegue.md). Este archivo NO se versiona con valores reales.

# Tu usuario/organización de GitHub (dueño de los paquetes en GHCR)
GHCR_OWNER=erashong-umg

# Dominio público de la app (usado por el backend para CORS_ORIGIN) — un
# subdominio propio, yettotools.com (raíz) ya está en uso por otro servicio
DOMAIN=educaspot.yettotools.com

# Credenciales de MongoDB (elegir una contraseña fuerte, no la de desarrollo)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=cambiar-por-una-contrasena-fuerte

# Secreto para firmar JWT — mínimo 32 caracteres, distinto al de desarrollo
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
